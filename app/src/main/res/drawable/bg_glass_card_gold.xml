<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#EB29200C"
                android:centerColor="#E61A150D"
                android:endColor="#EB0D101B" />
            <stroke
                android:width="1.4dp"
                android:color="#8CFFD600" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#24FFFFFF" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
