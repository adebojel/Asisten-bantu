<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="38dp"
                android:startColor="#66FF5252"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="oval">
            <solid android:color="#B31F0B12" />
            <stroke
                android:width="2dp"
                android:color="#CCFF5252" />
        </shape>
    </item>
</layer-list>
