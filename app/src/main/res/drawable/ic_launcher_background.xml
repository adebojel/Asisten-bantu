<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Latar belakang gelap modern (#0A0E17 -> #131A29) -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="108"
                android:endY="108"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item
                    android:color="#0A0E17"
                    android:offset="0.0" />
                <item
                    android:color="#0E1422"
                    android:offset="0.55" />
                <item
                    android:color="#131A29"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pendar cahaya radial halus hijau zamrud (#10B981 opacity ~20% di pusat) -->
    <path android:pathData="M54,6 A48,48 0 1,1 53.99,6 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="48"
                android:type="radial">
                <item
                    android:color="#3310B981"
                    android:offset="0.0" />
                <item
                    android:color="#1A10B981"
                    android:offset="0.55" />
                <item
                    android:color="#0010B981"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lingkaran cahaya tipis hijau zamrud (#10B981, opacity 20%) -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,15 A39,39 0 1,1 53.99,15 Z"
        android:strokeAlpha="0.20"
        android:strokeColor="#10B981"
        android:strokeWidth="1.2" />

    <!-- Lingkaran orbit dalam halus -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,21 A33,33 0 1,1 53.99,21 Z"
        android:strokeAlpha="0.12"
        android:strokeColor="#10B981"
        android:strokeWidth="0.8" />
</vector>
