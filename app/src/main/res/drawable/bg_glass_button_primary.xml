<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#0097A7"
                android:endColor="#00B8D4" />
            <stroke android:width="1.5dp" android:color="#80FFFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#66004D5A" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="135"
                        android:startColor="#00E5FF"
                        android:centerColor="#00B8D4"
                        android:endColor="#00838F" />
                    <stroke android:width="1.2dp" android:color="#66FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
