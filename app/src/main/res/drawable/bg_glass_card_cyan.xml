<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#80000000" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#EB12263F"
                android:centerColor="#E60E1C30"
                android:endColor="#EB0A1220" />
            <stroke
                android:width="1.5dp"
                android:color="#8C00E5FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#24FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
