<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud_backdrop"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header HUD Pembaca Dokumen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_glass_card_cyan"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Pembaca Dokumen"
            android:src="@drawable/ic_3d_document_scroll" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="PEMBACA DOKUMEN (.TXT &amp; .PDF)"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pembacaan suara per paragraf, ringkas AI &amp; terjemah."
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvDocStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_telemetry_pill"
        android:padding="12dp"
        android:text="Belum ada dokumen dipilih."
        android:textColor="#FFD600"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnPickDocument"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_button_primary"
        android:contentDescription="Pilih berkas teks atau dokumen PDF dari penyimpanan HP"
        android:text="PILIH DOKUMEN (.TXT / .PDF)"
        android:textColor="#06101C"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDocParagraph"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:text="Tekan Pilih Dokumen untuk membacakan isi file teks atau PDF per paragraf."
            android:textColor="#F8FAFC"
            android:textSize="18sp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDocPrev"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Paragraf sebelumnya"
            android:text="SEBELUM"
            android:textColor="#E2E8F0"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDocPlayPause"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_glass_button_primary"
            android:contentDescription="Putar atau jeda pembacaan dokumen"
            android:text="PUTAR"
            android:textColor="#06101C"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDocNext"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Paragraf berikutnya"
            android:text="LANJUT"
            android:textColor="#E2E8F0"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDocRepeat"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Ulangi paragraf saat ini"
            android:text="ULANGI"
            android:textColor="#E2E8F0" />

        <Button
            android:id="@+id/btnDocSummarize"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Ringkas isi dokumen dengan AI Kobra"
            android:text="RINGKAS"
            android:textColor="#00E5FF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDocTranslate"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Terjemahkan paragraf saat ini ke Indonesia atau Inggris"
            android:text="TERJEMAH"
            android:textColor="#FFD600"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDocBack"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_button_secondary"
        android:contentDescription="Kembali ke beranda"
        android:text="KEMBALI"
        android:textColor="#E2E8F0" />
</LinearLayout>
