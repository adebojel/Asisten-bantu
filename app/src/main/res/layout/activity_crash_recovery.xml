<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud_backdrop"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Peringatan Sistem"
                android:src="@drawable/ic_3d_warning_shield" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.05"
                android:text="PEMULIHAN SISTEM KOBRA OS"
                android:textColor="#FF6B6B"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aplikasi menangkap error tak terduga dan mencegah penutupan paksa berulang. Anda dapat menyalin detail error di bawah ini atau kembali ke beranda."
            android:textColor="#CBD5E1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCrashSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_telemetry_pill"
            android:padding="12dp"
            android:text="Memuat ringkasan error..."
            android:textColor="#FFD600"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvCrashDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="#E2E8F0"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </ScrollView>

    <Button
        android:id="@+id/btnCopyCrashLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_glass_button_secondary"
        android:contentDescription="Salin seluruh log error ke papan klip"
        android:minHeight="56dp"
        android:text="SALIN LOG ERROR"
        android:textColor="#00E5FF"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnReturnHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_button_primary"
        android:contentDescription="Kembali ke beranda utama Kobra OS"
        android:minHeight="60dp"
        android:text="KEMBALI KE BERANDA"
        android:textColor="#06101C"
        android:textStyle="bold" />
</LinearLayout>
