<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud_backdrop"
    android:orientation="vertical">

    <!-- Top Header with Back, Title, Status, and Barge-In Voice Orb -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6081020"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ASISTEN AI KOBRA"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChatModelInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Ketuk Orb atau Mic untuk interupsi suara"
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <com.asisten.bantu.VoiceOrbView
            android:id="@+id/voiceOrbChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Orb Barge-In Interupsi Suara" />
    </LinearLayout>

    <!-- 1-Tap Persona Switcher Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPersonaUtama"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_persona_chip_active"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Kobra Utama"
                android:textAllCaps="false"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPersonaPembaca"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_persona_chip_idle"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Pembaca &amp; Ringkas"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPersonaTutor"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_persona_chip_idle"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Tutor Bahasa"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPersonaKerja"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_persona_chip_idle"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Asisten Kerja"
                android:textAllCaps="false"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnHandsFreeConversation"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_glass_button_primary"
        android:contentDescription="Aktifkan percakapan suara hands-free bergantian"
        android:text="Percakapan hands-free"
        android:textAllCaps="false"
        android:textColor="#06101C"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Safe Mode Banner -->
    <Button
        android:id="@+id/btnResetSafeModeChat"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_glass_button_danger"
        android:text="RESET MODE AMAN MODEL LOKAL"
        android:textAllCaps="false"
        android:textColor="#FFE4E6"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Attachment indicator -->
    <TextView
        android:id="@+id/tvChatAttachment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/bg_badge_status"
        android:padding="8dp"
        android:text="Gambar terlampir siap dianalisis AI."
        android:textColor="#00E5FF"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Glassmorphism Chat Bubbles RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

    <!-- Bottom Input Bar & Giant 3D Mic Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EE070D1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnChatAttachImage"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Lampirkan gambar untuk Vision AI"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_image_pick" />

        <EditText
            android:id="@+id/etChatInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_input"
            android:hint="Tanya AI atau beri perintah..."
            android:imeOptions="actionSend"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:minHeight="46dp"
            android:padding="12dp"
            android:textColor="#E2E8F0"
            android:textColorHint="#64748B"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnChatSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Kirim pesan"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_send_arrow" />

        <ImageButton
            android:id="@+id/btnChatMic"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_glass_button_primary"
            android:contentDescription="Bicara dan potong suara AI"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_mic_orb" />
    </LinearLayout>
</LinearLayout>
