<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811">

    <!-- Fullscreen Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewVision"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Cybernetic HUD Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC060B16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBackVision"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="MATA KEDUA HUD 3D"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVisionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Arahkan kamera ke depan..."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Sensor Kamera"
            android:src="@drawable/ic_3d_eye_vision" />
    </LinearLayout>

    <!-- Bottom High-Contrast Glassmorphism Control & Result Panel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#EB060B16"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <!-- High-Contrast Glass Result Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glass_card_cyan"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvVisionResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="4"
                android:scrollbars="vertical"
                android:text="Ketuk salah satu tombol pindai di bawah atau katakan Kobra scan."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary Action Button (mode aktif saat ini) -->
        <Button
            android:id="@+id/btnScanVision"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_button_primary"
            android:drawableStart="@drawable/ic_3d_camera_scan"
            android:drawablePadding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="SCAN MODE AKTIF"
            android:textAllCaps="false"
            android:textColor="#06101C"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- 4 Large 3D Quick Mode Buttons (2x2) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnScanAllObjects"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:text="SCAN Semua Objek"
                android:textAllCaps="false"
                android:textColor="#00E5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnReadTextOcr"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:text="Baca Teks / OCR"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDetectMoneyColor"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:text="Deteksi Uang &amp; Warna"
                android:textAllCaps="false"
                android:textColor="#FFD600"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAskAiCamera"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:text="Tanya AI Kamera"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Secondary Utilities Strip (Galeri, Ringkas, Terjemah, Reset) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickImageVision"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="Galeri"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSummarizeVision"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="Ringkas"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTranslateVision"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="Terjemah"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnResetVision"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_glass_button_danger"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="#FFE4E6"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
