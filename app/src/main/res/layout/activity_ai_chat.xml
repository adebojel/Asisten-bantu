<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvModelStatusChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#00E676"
        android:textSize="14sp"
        android:paddingBottom="6dp"
        android:text="" />

    <ScrollView
        android:id="@+id/scrollChat"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:id="@+id/tvChatHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:text="" />
    </ScrollView>

    <Button
        android:id="@+id/btnImportModelChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:backgroundTint="#2962FF"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp"
        android:text="📁 IMPOR MODEL LOKAL (.TASK)"
        android:contentDescription="Impor berkas model bahasa offline titik task dari penyimpanan HP" />

    <Button
        android:id="@+id/btnListenChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:text="BICARA"
        android:contentDescription="Tekan untuk bicara" />

    <Button
        android:id="@+id/btnCloseChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:text="SELESAI"
        android:contentDescription="Tutup obrolan" />
</LinearLayout>
