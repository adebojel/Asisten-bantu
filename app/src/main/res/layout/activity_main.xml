<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud_backdrop"
    android:orientation="vertical">

    <!-- Top Cybernetic HUD Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Logo Kobra OS"
            android:src="@drawable/ic_3d_kobra_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMainHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="KOBRA OS"
                android:textColor="#E2E8F0"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBadgeSiaga"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_status"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="SIAGA • OFFLINE CORE"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Buka Pengaturan Terpadu"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_settings_gear" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <!-- Telemetry Strip 3D (Baterai, RAM, Jaringan) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_telemetry_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Baterai"
                        android:src="@drawable/ic_3d_battery_pulse" />

                    <TextView
                        android:id="@+id/tvTelemetryBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:text="--%"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_telemetry_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="RAM"
                        android:src="@drawable/ic_3d_ram_chip" />

                    <TextView
                        android:id="@+id/tvTelemetryRam"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:text="-- GB"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.15"
                    android:background="@drawable/bg_telemetry_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Jaringan"
                        android:src="@drawable/ic_3d_signal_beam" />

                    <TextView
                        android:id="@+id/tvTelemetryNet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:singleLine="true"
                        android:text="Offline"
                        android:textColor="#FFD600"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hero Voice Orb 3D Cockpit -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card_cyan"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <com.asisten.bantu.VoiceOrbView
                    android:id="@+id/voiceOrbMain"
                    android:layout_width="116dp"
                    android:layout_height="116dp"
                    android:contentDescription="Orb Suara 3D Kobra OS" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Kobra OS siap membantu secara offline maupun online."
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvQuickMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="Aksesibilitas • AI • Guardian SOS"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnShowFloatingOrb"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_button_secondary"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="TAMPILKAN GELEMBUNG SUARA MELAYANG"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnResetAiSafeMode"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_glass_button_danger"
                    android:text="MODE AMAN AI LOKAL • KELOLA MODEL"
                    android:textAllCaps="false"
                    android:textColor="#FFE4E6"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- SECTION 0: UTAMA (2x2 CORE GRID + QUICK STATUS STRIP) -->
            <LinearLayout
                android:id="@+id/sectionMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="MODUL UTAMA 3D"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Row 1: Mata Kedua + Mode Tongkat -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnSecondEyeMenu"
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="Mata Kedua"
                            android:src="@drawable/ic_3d_eye_vision" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Mata Kedua"
                            android:textColor="#E2E8F0"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Uang, OCR, Objek, KTP"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnStickCompass"
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="Mode Tongkat"
                            android:src="@drawable/ic_3d_radar_cane" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Mode Tongkat"
                            android:textColor="#E2E8F0"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Sonar 3D, Kompas, SOS"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: Asisten AI + Layar Utama -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/btnAiChat"
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="Asisten AI"
                            android:src="@drawable/ic_3d_ai_core" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Asisten AI"
                            android:textColor="#E2E8F0"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Persona, Barge-In, Memori"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnOpenKobraHome"
                        android:layout_width="0dp"
                        android:layout_height="132dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:contentDescription="Layar Utama"
                            android:src="@drawable/ic_3d_launcher_grid" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Layar Utama"
                            android:textColor="#E2E8F0"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Peluncur 3D Glass Tile"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Daily Briefing & Guardian Check-In Quick Strip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDailyBriefingMain"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_button_secondary"
                        android:text="Ringkasan Harian"
                        android:textAllCaps="false"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnQuickGuardianAck"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_button_secondary"
                        android:text="Konfirmasi Aman"
                        android:textAllCaps="false"
                        android:textColor="#FFD600"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 1: UTILITAS, MEDIS & NAVIGASI -->
            <LinearLayout
                android:id="@+id/sectionUtils"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="UTILITAS, MEDIS &amp; KESEHATAN"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/btnDocumentReader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Pembaca Dokumen"
                        android:src="@drawable/ic_3d_document_scroll" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pembaca Dokumen PDF &amp; Teks" android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Baca, ringkas, dan terjemahkan dokumen" android:textColor="#94A3B8" android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Buka" android:src="@drawable/ic_3d_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPedometer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="Langkah" android:src="@drawable/ic_3d_radar_cane" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Penghitung Langkah Offline" android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvPedometerCardSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 langkah (0 m)" android:textColor="#00E5FF" android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Buka" android:src="@drawable/ic_3d_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnProductivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="Agenda" android:src="@drawable/ic_3d_clock_planner" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Agenda Harian &amp; Jadwal Obat" android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pengingat jam dan catatan pribadi" android:textColor="#94A3B8" android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Buka" android:src="@drawable/ic_3d_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnMedicalCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="Kartu Medis" android:src="@drawable/ic_3d_medical_cross" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kartu Identitas Medis Darurat" android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Golongan darah, alergi, dan kontak keluarga" android:textColor="#94A3B8" android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Buka" android:src="@drawable/ic_3d_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCompass"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="Kompas" android:src="@drawable/ic_3d_compass_rose" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kompas Suara &amp; Rute Pulang" android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arah mata angin, lokasi GPS, tempat favorit" android:textColor="#94A3B8" android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Buka" android:src="@drawable/ic_3d_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnPrayer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="Sholat" android:src="@drawable/ic_3d_prayer_dome" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Jadwal Sholat &amp; Arah Kiblat" android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Perhitungan astronomi offline" android:textColor="#94A3B8" android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Buka" android:src="@drawable/ic_3d_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCaregiver"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView android:layout_width="32dp" android:layout_height="32dp" android:contentDescription="Pendamping" android:src="@drawable/ic_3d_caregiver_link" />

                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mode Pendamping &amp; Keluarga" android:textColor="#E2E8F0" android:textSize="14sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pantau status baterai, langkah, dan SOS" android:textColor="#94A3B8" android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="Buka" android:src="@drawable/ic_3d_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCheckFinance"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_button_secondary"
                        android:text="Cek Mutasi Keuangan"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnCheckSignal"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_button_secondary"
                        android:text="Cek Sinyal &amp; Operator"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- SECTION 2: PANDUAN VOICE ACCESS & PERINTAH SUARA -->
            <LinearLayout
                android:id="@+id/sectionVoice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnVoiceGuide"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_glass_button_primary"
                    android:text="BACAKAN PANDUAN LENGKAP"
                    android:textAllCaps="false"
                    android:textColor="#06101C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="CONTOH VOICE ACCESS &amp; NAVIGASI"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button android:id="@+id/cmdNav1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Tampilkan nomor • Klik nomor 3 • Tekan lama 2" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />
                <Button android:id="@+id/cmdNav2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Tampilkan grid • Zoom 5 • Ketik Saya sedang di jalan" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />
                <Button android:id="@+id/cmdNav3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Baca layar • Gulir bawah • Kembali • Mode tidur" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="MEDIA, KAMERA &amp; HARIAN"
                    android:textColor="#FFD600"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <Button android:id="@+id/cmdMedia1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Putar murottal di YouTube • Volume naik" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />
                <Button android:id="@+id/cmdMedia2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Jeda media • Lanjut media • Jawab telepon" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />
                <Button android:id="@+id/cmdCam1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Hitung lembar uang • Baca uang • Cocokkan baju" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />
                <Button android:id="@+id/cmdDaily1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Ringkasan harian • Saya aman • Ingat bahwa ..." android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />
                <Button android:id="@+id/cmdDaily2" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_glass_card" android:gravity="start|center_vertical" android:padding="12dp" android:text="Cek langkah hari ini • Cek sinyal • Tolong SOS" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 3 Modern Bottom Tabs (Utama, Utilitas, Panduan) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6070D19"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <Button
            android:id="@+id/tabMain"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_active"
            android:text="Utama"
            android:textAllCaps="false"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabUtils"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:text="Utilitas"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tabVoice"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_tab_inactive"
            android:text="Panduan"
            android:textAllCaps="false"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
