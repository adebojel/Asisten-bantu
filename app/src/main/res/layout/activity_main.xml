<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:paddingBottom="16dp"
            android:text="Memuat status..." />

        <Button
            android:id="@+id/btnVoiceGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#2962FF"
            android:textColor="#FFFFFF"
            android:text="🔊 Panduan Suara Aplikasi"
            android:contentDescription="Panduan Suara Aplikasi. Ketuk untuk mendengarkan fungsi setiap tombol utama." />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="1. Beri izin (mikrofon, kamera, lokasi, kontak, SMS, telepon)"
            android:contentDescription="Beri izin aplikasi" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="2. Aktifkan layanan aksesibilitas Kobra"
            android:contentDescription="Buka pengaturan aksesibilitas" />

        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="3. Aktifkan akses notifikasi (baca notifikasi dan telepon masuk)"
            android:contentDescription="Buka pengaturan akses notifikasi" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="4. Pengaturan AI (OpenRouter dan n8n)"
            android:contentDescription="Buka pengaturan AI" />

        <Button
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="5. Kontak darurat SOS"
            android:contentDescription="Atur kontak darurat" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="6. Jangan matikan Kobra saat baterai hemat"
            android:contentDescription="Izinkan berjalan di latar belakang" />

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="7. Jalankan Kobra di latar belakang"
            android:contentDescription="Jalankan layanan Kobra" />

        <Button
            android:id="@+id/btnLauncher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="8. Jadikan Kobra sebagai layar utama"
            android:contentDescription="Pilih layar utama" />

        <Button
            android:id="@+id/btnCompass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="64dp"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:text="🧭 Kompas Suara, Lokasi &amp; Rute Pulang"
            android:contentDescription="Buka kompas suara offline, cek lokasi GPS, dan penanda rute pulang" />

        <Button
            android:id="@+id/btnMedicalCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="64dp"
            android:backgroundTint="#EF6C00"
            android:textColor="#FFFFFF"
            android:text="🏥 Kartu Identitas Medis Darurat"
            android:contentDescription="Buka dan atur kartu identitas medis darurat" />

        <Button
            android:id="@+id/btnProductivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="64dp"
            android:backgroundTint="#7C4DFF"
            android:textColor="#FFFFFF"
            android:text="📅 Memo, Barang, Pengeluaran &amp; Obat"
            android:contentDescription="Buka memo suara, pengingat lokasi barang, pengeluaran harian, jadwal obat, dan agenda Hijriah" />

        <Button
            android:id="@+id/btnPrayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="64dp"
            android:backgroundTint="#00695C"
            android:textColor="#FFFFFF"
            android:text="🕌 Jadwal Sholat &amp; Kiblat Offline"
            android:contentDescription="Buka jadwal sholat lima waktu dan kompas kiblat offline" />

        <Button
            android:id="@+id/btnCaregiver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="64dp"
            android:backgroundTint="#37474F"
            android:textColor="#FFFFFF"
            android:text="👨‍👩‍👧 Mode Pendamping (PIN &amp; Keluarga)"
            android:contentDescription="Buka mode pendamping untuk mengatur PIN keamanan, pengawasan, dan jadwal obat" />

        <Button
            android:id="@+id/btnSecondEyeMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="64dp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:text="👁️ Mata Kedua (Uang, Baju, Layar, Struk, Barcode, Objek)"
            android:contentDescription="Pilih mode kamera Mata Kedua: penghitung uang tunai, padu padan pakaian, pembaca layar digital, pemindai struk transfer, barcode, cari objek, atau terjemahan kamera" />

        <Button
            android:id="@+id/btnDocumentReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="64dp"
            android:backgroundTint="#4E342E"
            android:textColor="#FFFFFF"
            android:text="📄 Pembaca Dokumen (.TXT &amp; .PDF)"
            android:contentDescription="Buka pembaca dokumen teks dan PDF dengan kontrol jeda, lanjut, ulangi paragraf, ringkasan AI, dan terjemahan offline" />
    </LinearLayout>
</ScrollView>
