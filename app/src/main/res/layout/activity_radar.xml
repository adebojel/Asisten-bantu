<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050811">

    <!-- Fullscreen Camera Background -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewViewNav"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark translucent tint over camera for 3D Sonar HUD readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66050811" />

    <!-- Top Radar HUD Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC060B16"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/btnBackRadar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="SONAR RADAR 3D &amp; GUARDIAN"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNavStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mode tongkat siaga"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="Sonar Radar"
            android:src="@drawable/ic_3d_radar_cane" />
    </LinearLayout>

    <!-- Center 3D Sonar Radar Visualizer -->
    <com.asisten.bantu.SonarRadarView
        android:id="@+id/sonarRadarView"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="center"
        android:layout_marginBottom="90dp"
        android:contentDescription="Visualisasi Radar Rintangan 3D" />

    <!-- Bottom HUD Control Deck: Obstacle readout + Start/Stop + Guardian Check-In + Large SOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#EE060B16"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvObstacle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_glass_card_cyan"
            android:gravity="center"
            android:padding="12dp"
            android:text="Arahkan kamera ke depan untuk memindai jalur jalan."
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_button_primary"
                android:text="MULAI RADAR"
                android:textAllCaps="false"
                android:textColor="#06101C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopNav"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_button_secondary"
                android:text="HENTIKAN"
                android:textAllCaps="false"
                android:textColor="#E2E8F0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Guardian Check-In Strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvGuardianStatusNav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Guardian Check-In: Siaga"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGuardianAckNav"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Saya Aman"
                android:textAllCaps="false"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnGuardianCheckNowNav"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_button_secondary"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Tes Check-In"
                android:textAllCaps="false"
                android:textColor="#FFD600"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Large 3D Emergency SOS Button -->
        <Button
            android:id="@+id/btnEmergencySosNav"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_glass_button_danger"
            android:drawableStart="@drawable/ic_3d_sos_shield"
            android:drawablePadding="8dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="DARURAT SOS &amp; SIRINE"
            android:textAllCaps="false"
            android:textColor="#FFE4E6"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
