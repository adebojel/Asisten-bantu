<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud_backdrop"
    android:orientation="vertical">

    <!-- Top HUD Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E6081020"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageButton
            android:id="@+id/btnBackSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Kembali"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_back_arrow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.06"
                android:text="PUSAT PENGATURAN TERPADU"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSettingsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Semua izin, AI, memori, sensor &amp; keamanan ada di sini."
                android:textColor="#94A3B8"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="Pengaturan"
            android:src="@drawable/ic_3d_settings_gear" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD 1: IZIN SISTEM & ASISTEN DEFAULT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card_cyan"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="1. IZIN SISTEM &amp; ASISTEN DEFAULT"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSystemPermSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="10dp"
                    android:text="Memeriksa status izin..."
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnSettingsPermissions" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Izin Aplikasi" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnSettingsAccessibility" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_primary" android:text="Aksesibilitas" android:textAllCaps="false" android:textColor="#06101C" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnSettingsOverlay" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Izin Overlay" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnSettingsNotifAccess" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Baca Notifikasi" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnSettingsBattery" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Bebas Baterai" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnSettingsStartService" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Aktifkan Siaga" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <Button android:id="@+id/btnSettingsDefaultAssistant" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="6dp" android:layout_weight="1.2" android:background="@drawable/bg_glass_button_secondary" android:text="Asisten Digital Default" android:textAllCaps="false" android:textColor="#FFD600" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnSettingsLauncher" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Launcher Home" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 2: KECERDASAN BUATAN & MODEL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="2. KECERDASAN BUATAN &amp; MODEL"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Gemini API Key (Opsional • Google AI Studio)" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                <EditText
                    android:id="@+id/etGeminiApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_input"
                    android:hint="AIzaSy... (opsional, AI Online Gratis aktif tanpa key)"
                    android:inputType="textNoSuggestions"
                    android:padding="10dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="OpenRouter API Key (Opsional • Cadangan Online)" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                <EditText
                    android:id="@+id/etApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_input"
                    android:hint="sk-or-v1-... (opsional)"
                    android:inputType="textNoSuggestions"
                    android:padding="10dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Nama Model Online (Kosong = Otomatis)" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                <EditText
                    android:id="@+id/etModel"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_input"
                    android:hint="Otomatis model gratis"
                    android:inputType="textNoSuggestions"
                    android:padding="10dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Webhook Otomatisasi n8n (Opsional)" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                <EditText
                    android:id="@+id/etN8nUrl"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_input"
                    android:hint="https://..."
                    android:inputType="textUri"
                    android:padding="10dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnTestAi"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_button_secondary"
                    android:text="Uji Koneksi AI Online"
                    android:textAllCaps="false"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvModelStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Status model offline: Memeriksa..."
                    android:textColor="#FFD600"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbImportModel"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvImportProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnImportModel" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_primary" android:text="Impor Model .task" android:textAllCaps="false" android:textColor="#06101C" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnLoadModel" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Muat / Uji" android:textAllCaps="false" android:textColor="#00E5FF" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnDeleteModel" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="0.8" android:background="@drawable/bg_glass_button_danger" android:text="Hapus" android:textAllCaps="false" android:textColor="#FFE4E6" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 3: MEMORI AI LOKAL (PERSISTENT MEMORY MANAGER) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="Memori AI" android:src="@drawable/ic_3d_memory_chip" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:letterSpacing="0.05" android:text="3. MEMORI AI LOKAL" android:textColor="#00E5FF" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvMemoryCountInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fakta pribadi dan preferensi yang selalu diingat asisten secara lokal."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnAddMemory" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginEnd="6dp" android:layout_weight="1.3" android:background="@drawable/bg_glass_button_secondary" android:text="Tambah Memori Baru" android:textAllCaps="false" android:textColor="#00E5FF" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnClearMemories" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_danger" android:text="Hapus Semua" android:textAllCaps="false" android:textColor="#FFE4E6" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutMemoryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- CARD 4: IDENTITAS ASISTEN & KARAKTER SUARA (7 PRESET NUSANTARA ALA GEMINI) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card_cyan"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:contentDescription="Karakter Suara Asisten"
                        android:src="@drawable/ic_3d_speaker_wave" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.05"
                        android:text="4. IDENTITAS ASISTEN &amp; KARAKTER SUARA"
                        android:textColor="#00E5FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActiveVoiceSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="10dp"
                    android:text="Aktif: Kobra (Tegas &amp; Netral • Pitch 1.0x • Rate 1.0x)"
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <!-- Row 1: Kobra & Arka -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresetKobra"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_persona_chip_active"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Kobra\nTegas &amp; Netral"
                        android:textAllCaps="false"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPresetArka"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_persona_chip_idle"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Arka\nBersahabat &amp; Jelas"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2: Bima & Nala -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresetBima"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_persona_chip_idle"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Bima\nPria Berwibawa"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPresetNala"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_persona_chip_idle"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Nala\nWanita Lembut"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 3: Cakra & Tara -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPresetCakra"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_persona_chip_idle"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Cakra\nCepat &amp; Sigap"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnPresetTara"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_persona_chip_idle"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Tara\nCeria &amp; Energik"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 4: Kustom Sendiri -->
                <Button
                    android:id="@+id/btnPresetKustom"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_persona_chip_idle"
                    android:text="Kustom Sendiri • Nama Panggilan, Pitch &amp; Kecepatan Bebas"
                    android:textAllCaps="false"
                    android:textColor="#FFD600"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/layoutCustomVoiceConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_telemetry_pill"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nama Panggilan Asisten Kustom (Wake Word)"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etCustomAssistantName"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_glass_input"
                        android:hint="Contoh: Surya, Citra, Bayu"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="24"
                        android:padding="10dp"
                        android:textColor="#E2E8F0"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Atur Pitch (0.5x–1.8x) &amp; Kecepatan (0.5x–2.0x) di panel Kontrol Suara di bawah, lalu terapkan."
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btnApplyCustomVoice"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_glass_button_primary"
                        android:text="Terapkan &amp; Putar Sampel Suara Kustom"
                        android:textAllCaps="false"
                        android:textColor="#06101C"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- CARD 5: KONTROL SUARA, NOMOR LAYAR & SENSOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="5. KONTROL SUARA, NOMOR LAYAR &amp; SENSOR"
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swFloatingOrb" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Gelembung Mikrofon Melayang Global" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swFloatingOrbAutoHide" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Otomatis Sembunyi ke Pinggir Layar (Auto-Hide Edge)" android:textColor="#E2E8F0" android:textSize="13sp" />
                <TextView android:id="@+id/tvFloatingOrbAlpha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Tingkat Transparansi Gelembung: 45%" android:textColor="#E2E8F0" android:textSize="12sp" />
                <SeekBar android:id="@+id/sbFloatingOrbAlpha" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="75" />

                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swGlobalScreenReader" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Pembaca Layar Global (Aplikasi Lain)" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swVisualNumbers" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Nomor Layar Visual (Voice Access)" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swGridOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Grid Koordinat Presisi 3x3" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swAirGestures" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Air Gestures Sensor Jarak (Lambaian Tangan)" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swBargeIn" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Barge-In (Potong Suara AI Saat Bicara)" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swHighContrast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Mode Kontras Tinggi" android:textColor="#E2E8F0" android:textSize="13sp" />

                <TextView android:id="@+id/tvSpeechRate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Kecepatan Suara (Rate): 1.0x" android:textColor="#E2E8F0" android:textSize="12sp" />
                <SeekBar android:id="@+id/sbSpeechRate" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="15" />

                <TextView android:id="@+id/tvSpeechPitch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Nada Suara (Pitch): 1.0x" android:textColor="#E2E8F0" android:textSize="12sp" />
                <SeekBar android:id="@+id/sbSpeechPitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="13" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Gaya Bahasa Asisten" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/rgAssistantStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <RadioButton android:id="@+id/rbStyleRingkas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ringkas (padat ke inti)" android:textColor="#E2E8F0" android:textSize="12sp" />
                    <RadioButton android:id="@+id/rbStyleRamah" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ramah (hangat &amp; jelas)" android:textColor="#E2E8F0" android:textSize="12sp" />
                    <RadioButton android:id="@+id/rbStyleDaerah" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bahasa Daerah Dasar (halus)" android:textColor="#E2E8F0" android:textSize="12sp" />
                </RadioGroup>

                <Button android:id="@+id/btnTestTts" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_glass_button_secondary" android:text="Tes Contoh Suara TTS" android:textAllCaps="false" android:textColor="#00E5FF" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <!-- CARD 6: KEAMANAN, DAILY BRIEFING & GUARDIAN SOS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_glass_card_gold"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="6. KEAMANAN, DAILY BRIEFING &amp; GUARDIAN SOS"
                    android:textColor="#FFD600"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSettingsSos"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_glass_button_danger"
                    android:text="Atur Kontak Darurat SOS"
                    android:textAllCaps="false"
                    android:textColor="#FFE4E6"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swFallDetection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Deteksi Jatuh Otomatis (SOS)" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swPocketLock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Kunci Saku Sensor Jarak" android:textColor="#E2E8F0" android:textSize="13sp" />
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/swDailyBriefing" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Daily Morning Briefing" android:textColor="#E2E8F0" android:textSize="13sp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Interval Pemeriksaan Guardian Check-In" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                <RadioGroup android:id="@+id/rgGuardianInterval" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbGuardOff" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mati" android:textColor="#E2E8F0" android:textSize="11sp" />
                    <RadioButton android:id="@+id/rbGuard15" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="15m" android:textColor="#E2E8F0" android:textSize="11sp" />
                    <RadioButton android:id="@+id/rbGuard30" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30m" android:textColor="#E2E8F0" android:textSize="11sp" />
                    <RadioButton android:id="@+id/rbGuard60" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="60m" android:textColor="#E2E8F0" android:textSize="11sp" />
                </RadioGroup>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnTestDailyBriefing" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Tes Briefing" android:textAllCaps="false" android:textColor="#00E5FF" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnTestGuardianCheck" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Tes Check-In" android:textAllCaps="false" android:textColor="#FFD600" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Catatan Pribadi Offline" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                <EditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="84dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_input"
                    android:gravity="top|start"
                    android:hint="Catatan penting atau alamat..."
                    android:inputType="textMultiLine"
                    android:padding="10dp"
                    android:textColor="#E2E8F0"
                    android:textColorHint="#64748B"
                    android:textSize="13sp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                    <Button android:id="@+id/btnBackupData" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Cadangkan JSON" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                    <Button android:id="@+id/btnRestoreData" android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1" android:background="@drawable/bg_glass_button_secondary" android:text="Pulihkan JSON" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/tvBackupStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="#94A3B8" android:textSize="11sp" />

                <Button android:id="@+id/btnCheckUpdate" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_glass_button_secondary" android:text="Cek Pembaruan Kobra OS (OTA)" android:textAllCaps="false" android:textColor="#00E5FF" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvUpdateStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Versi terpasang" android:textColor="#94A3B8" android:textSize="11sp" />

                <Button android:id="@+id/btnViewCrashLog" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="8dp" android:background="@drawable/bg_glass_button_secondary" android:text="Lihat Log Crash Terakhir" android:textAllCaps="false" android:textColor="#E2E8F0" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_glass_button_primary"
                android:text="SIMPAN SEMUA PENGATURAN"
                android:textAllCaps="false"
                android:textColor="#06101C"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
