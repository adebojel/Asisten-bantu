<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:text="API key OpenRouter (gratis, daftar di openrouter.ai)" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tempel API key di sini"
            android:inputType="textVisiblePassword"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:minHeight="56dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:text="Model AI (kosongkan untuk otomatis memakai model gratis bawaan)" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="contoh: meta-llama/llama-3.3-70b-instruct:free"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:minHeight="56dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:text="Webhook n8n (opsional, kosongkan jika tidak dipakai)" />

        <EditText
            android:id="@+id/etN8nUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://nama-anda.app.n8n.cloud/webhook/kobra"
            android:inputType="textUri"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:minHeight="56dp" />

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="SIMPAN"
            android:contentDescription="Simpan pengaturan AI" />

        <Button
            android:id="@+id/btnTestAi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:text="TES AI"
            android:contentDescription="Tes koneksi ke AI" />

        <TextView
            android:id="@+id/tvSettingsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textColor="#00E676"
            android:textSize="18sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="🧠 Model AI Offline (Gemma 3 1B)" />

        <TextView
            android:id="@+id/tvModelStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="Status model: Memeriksa..." />

        <Button
            android:id="@+id/btnImportModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:backgroundTint="#2962FF"
            android:textColor="#FFFFFF"
            android:text="📁 IMPOR MODEL LOKAL (.TASK)"
            android:contentDescription="Impor berkas model offline titik task dari folder Download atau penyimpanan HP" />

        <ProgressBar
            android:id="@+id/pbImportModel"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvImportProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#FFFFEB3B"
            android:textSize="15sp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="🔊 Aksesibilitas, Suara TTS &amp; Kontras" />

        <TextView
            android:id="@+id/tvSpeechRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="Kecepatan Suara (Rate): 0.9x" />

        <SeekBar
            android:id="@+id/sbSpeechRate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:max="15"
            android:progress="4"
            android:contentDescription="Atur kecepatan bicara suara asisten dari 0 koma 5 hingga 2 kali" />

        <TextView
            android:id="@+id/tvSpeechPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="10dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:text="Nada Suara (Pitch): 1.0x" />

        <SeekBar
            android:id="@+id/sbSpeechPitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:max="15"
            android:progress="5"
            android:contentDescription="Atur nada suara asisten dari rendah hingga tinggi" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swHighContrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:text="Mode Kontras Tinggi"
            android:contentDescription="Aktifkan atau matikan mode kontras tinggi pada tampilan" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:text="Gaya Bahasa Asisten AI" />

        <RadioGroup
            android:id="@+id/rgAssistantStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:contentDescription="Pilih gaya bahasa jawaban asisten AI">

            <RadioButton
                android:id="@+id/rbStyleRingkas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="#FFFFFF"
                android:buttonTint="#00E676"
                android:text="Ringkas (padat langsung inti)"
                android:contentDescription="Gaya bahasa ringkas, jawaban sangat padat dan langsung ke inti" />

            <RadioButton
                android:id="@+id/rbStyleRamah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="#FFFFFF"
                android:buttonTint="#00E676"
                android:text="Ramah (jelas dan bersahabat)"
                android:contentDescription="Gaya bahasa ramah, hangat, jelas, dan bersahabat" />

            <RadioButton
                android:id="@+id/rbStyleDaerah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="#FFFFFF"
                android:buttonTint="#00E676"
                android:text="Bahasa Daerah Dasar (sapaan Nusantara sopan)"
                android:contentDescription="Gaya bahasa daerah dasar dengan sapaan Nusantara yang sopan" />
        </RadioGroup>

        <Button
            android:id="@+id/btnTestTts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#7C4DFF"
            android:textColor="#FFFFFF"
            android:text="🔊 TES SUARA TTS"
            android:contentDescription="Uji kecepatan dan nada suara asisten saat ini" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:text="Catatan Pribadi (ikut dicadangkan offline)" />

        <EditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:gravity="top|start"
            android:hint="Tulis catatan pribadi atau pengingat..."
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:contentDescription="Kolom catatan pribadi yang ikut dicadangkan" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="💾 Portabilitas Data Offline (JSON)" />

        <Button
            android:id="@+id/btnBackupData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="60dp"
            android:backgroundTint="#00897B"
            android:textColor="#FFFFFF"
            android:text="📤 CADANGKAN DATA (EKSPOR)"
            android:contentDescription="Cadangkan seluruh pengaturan dan kontak darurat ke berkas JSON tanpa file model" />

        <Button
            android:id="@+id/btnRestoreData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="60dp"
            android:backgroundTint="#EF6C00"
            android:textColor="#FFFFFF"
            android:text="📥 PULIHKAN DATA (IMPOR)"
            android:contentDescription="Pulihkan seluruh pengaturan dan kontak darurat dari berkas cadangan JSON" />

        <TextView
            android:id="@+id/tvBackupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFEB3B"
            android:textSize="15sp"
            android:text="" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#333333" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="🔄 Pembaruan Aplikasi Mandiri (GitHub Releases)" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="60dp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:text="⬇️ CEK PEMBARUAN KOBRA OS"
            android:contentDescription="Periksa pembaruan Kobra OS terbaru dari GitHub Releases dan unduh paket APK" />

        <TextView
            android:id="@+id/tvUpdateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FFFFEB3B"
            android:textSize="15sp"
            android:text="" />

        <Button
            android:id="@+id/btnBackSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="64dp"
            android:text="KEMBALI"
            android:contentDescription="Kembali" />
    </LinearLayout>
</ScrollView>
