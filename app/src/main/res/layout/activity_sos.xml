<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🆘 KONTAK DARURAT"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FF5252"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etName1"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nama Kontak 1"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="#222222"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPhone1"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="No HP 1"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="#222222"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etName2"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nama Kontak 2"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="#222222"
            android:padding="12dp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etPhone2"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="No HP 2"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="#222222"
            android:padding="12dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSaveSos"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="💾 SIMPAN"
            android:backgroundTint="#00C853"
            android:contentDescription="Simpan kontak darurat SOS" />

        <Button
            android:id="@+id/btnSosPractice"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="12dp"
            android:text="🧪 MODE LATIHAN SOS (SIMULASI)"
            android:backgroundTint="#2962FF"
            android:textColor="#FFFFFF"
            android:contentDescription="Jalankan simulasi latihan SOS tanpa mengirim SMS atau menelepon asli" />

        <Button
            android:id="@+id/btnOpenMedicalCard"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="10dp"
            android:text="🏥 KARTU IDENTITAS MEDIS DARURAT"
            android:backgroundTint="#EF6C00"
            android:textColor="#FFFFFF"
            android:contentDescription="Buka dan atur kartu identitas medis darurat" />

        <TextView
            android:id="@+id/tvSosStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum diatur (Default: 112)"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>
