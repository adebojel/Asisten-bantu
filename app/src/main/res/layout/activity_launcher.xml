<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hud_backdrop"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header Clock & Voice Orb Trigger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card_cyan"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="KOBRA LAUNCHER"
                android:textColor="#00E5FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="00:00"
                android:textColor="#E2E8F0"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_glass_button_primary"
            android:contentDescription="Pemicu Suara Kobra"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_3d_mic_orb" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvListen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_telemetry_pill"
        android:padding="10dp"
        android:text="Siap mendengarkan perintah suara..."
        android:textColor="#E2E8F0"
        android:textSize="13sp" />

    <!-- Spaced 3D Glass Tile Quick Grid -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReadScreen"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:text="Baca Layar"
            android:textAllCaps="false"
            android:textColor="#00E5FF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNavStick"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:text="Mode Tongkat"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAiChat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_card"
            android:text="Asisten AI"
            android:textAllCaps="false"
            android:textColor="#FFD600"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnVisionMoney"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:text="Baca Uang"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVisionColor"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:text="Warna"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVisionFace"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:text="Wajah"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnVisionKtp"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_button_secondary"
            android:text="Baca KTP"
            android:textAllCaps="false"
            android:textColor="#E2E8F0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnSosEmergency"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_glass_button_danger"
        android:drawableStart="@drawable/ic_3d_sos_shield"
        android:drawablePadding="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="PANGGILAN DARURAT SOS"
        android:textAllCaps="false"
        android:textColor="#FFE4E6"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvScreenReader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:text="Hasil baca layar tampil di sini."
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1" />
</LinearLayout>
