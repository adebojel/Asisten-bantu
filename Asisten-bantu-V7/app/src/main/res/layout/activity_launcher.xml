<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#000000" android:padding="10dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🐍 KOBRA OS V6 OTAK SUPER" android:textSize="22sp" android:textStyle="bold" android:textColor="#00E676" android:gravity="center"/>
    <TextView android:id="@+id/tvClock" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="00:00" android:textSize="32sp" android:textColor="#FFFFFF" android:gravity="center"/>
    <TextView android:id="@+id/tvListen" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🎤 Ucapkan KOBRA" android:textSize="16sp" android:textColor="#FFFFEB3B" android:gravity="center" android:background="#222222" android:padding="10dp" android:layout_marginBottom="6dp"/>
    <TextView android:id="@+id/tvScreenReader" android:layout_width="match_parent" android:layout_height="80dp" android:text="V6 Otak Super siap..." android:textColor="#FFFFFF" android:background="#111111" android:padding="8dp" android:textSize="12sp" android:layout_marginBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnVisionMoney" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="💵 UANG" android:textSize="11sp" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnVisionColor" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="🎨 WARNA" android:textSize="11sp" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnVisionFace" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="🧑 ORANG" android:textSize="11sp" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnVisionKtp" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:text="🪪 KTP" android:textSize="11sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
        <Button android:id="@+id/btnNavStick" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="🦯 MODE TONGKAT" android:layout_marginEnd="3dp" android:backgroundTint="#FF9800"/>
        <Button android:id="@+id/btnAiChat" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="🧠 TEMAN NGOBROL AI" android:layout_marginStart="3dp" android:backgroundTint="#7C4DFF"/>
    </LinearLayout>
    <Button android:id="@+id/btnSosEmergency" android:layout_width="match_parent" android:layout_height="55dp" android:text="🆘 KOBRA TOLONG SOS" android:backgroundTint="#D32F2F" android:layout_marginBottom="6dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvApps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <Button android:id="@+id/btnReadScreen" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="BACA LAYAR" android:layout_marginEnd="3dp"/>
        <Button android:id="@+id/btnMic" android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:text="🎤 KOBRA" android:layout_marginStart="3dp"/>
    </LinearLayout>
</LinearLayout>

